{
  "manifest_version": 3,
  "name": "GitHub Notifications Redirect",
  "version": "0.2.0",
  "description": "Open GitHub notifications in one pinned GitGlance tab.",
  "permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
